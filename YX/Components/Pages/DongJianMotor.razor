@page "/DongJianMotor"
@rendermode InteractiveServer
@using YX.Services
@using YX.Models
<PageTitle>东箭电机数据分析</PageTitle>

<div class="container">
    <h2>东箭电机数据分析</h2>
    
    <!-- 基本信息输入 -->
    <div class="input-row">
        <div class="input-group">
            <label for="motorName">电机名称</label>
            <input type="text" id="motorName" @bind="Motor.MotorName" placeholder="请输入电机名称" />
        </div>
    </div>
    
    <!-- 电压输入 -->
    <div class="input-row">
        <div class="input-group">
            <label for="voltage">电压 (V)</label>
            <input type="number" id="voltage" @bind="Motor.Voltage" placeholder="请输入电压" step="0.1" min="0" />
        </div>
    </div>
    
    <!-- 单位选择 -->
    <div class="unit-selection">
        <h3>单位设置</h3>
        <div class="input-row">
            <div class="input-group">
                <label>输入扭矩单位：</label>
                <select @bind="InputTorqueUnit">
                    <option value="@TorqueUnit.Nm">Nm</option>
                    <option value="@TorqueUnit.mNm">mNm</option>
                    <option value="@TorqueUnit.Kgcm">kg.cm</option>
                    <option value="@TorqueUnit.gcm">g.cm</option>
                </select>
            </div>
            <div class="input-group">
                <label>输入电流单位：</label>
                <select @bind="InputCurrentUnit">
                    <option value="@CurrentUnit.A">A</option>
                    <option value="@CurrentUnit.mA">mA</option>
                </select>
            </div>
        </div>
        <div class="input-row">
            <div class="input-group">
                <label>输出扭矩单位：</label>
                <select @bind="OutputTorqueUnit">
                    <option value="@TorqueUnit.Nm">Nm</option>
                    <option value="@TorqueUnit.mNm">mNm</option>
                    <option value="@TorqueUnit.Kgcm">kg.cm</option>
                    <option value="@TorqueUnit.gcm">g.cm</option>
                </select>
            </div>
            <div class="input-group">
                <label>输出电流单位：</label>
                <select @bind="OutputCurrentUnit">
                    <option value="@CurrentUnit.A">A</option>
                    <option value="@CurrentUnit.mA">mA</option>
                </select>
            </div>
        </div>
    </div>
    
    <!-- 数据表格 -->
    <div class="table-container">
        <h3>电机测试数据</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th>扭矩 (@(InputTorqueUnit.ToString() == "Kgcm" ? "kg.cm" : InputTorqueUnit.ToString()))</th>
                    <th>电流 (@(InputCurrentUnit.ToString()))</th>
                    <th>转速 (rpm)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (point, index) in DataPoints.Select((p, i) => (p, i)))
                {
                    <tr @onclick="() => SelectRow(index)" class="@(SelectedIndex == index ? "selected" : "")">
                        <td><input type="number" @bind="point.Torque" /></td>
                        <td><input type="number" @bind="point.Current" /></td>
                        <td><input type="number" @bind="point.Speed" /></td>
                    </tr>
                }
            </tbody>
        </table>
        
        <!-- 表格操作按钮 -->
        <div class="button-group">
            <button class="btn btn-secondary" @onclick="AddRow">在选中行下方添加</button>
            <button class="btn btn-danger" @onclick="DeleteRow" disabled="@(SelectedIndex == -1)">删除选中行</button>
        </div>
    </div>
    
    <!-- 计算按钮 -->
    <div class="button-group">
        <button class="btn btn-primary" @onclick="CalculateFits">计算拟合直线</button>
        <button class="btn export-btn" @onclick="ExportData">导出数据 (CSV)</button>
    </div>
    
    <!-- 拟合结果 -->
    @if (ShowResults)
    {
        <div class="results-container">
            <h3>拟合结果</h3>
            <div class="equation">
                <span class="equation-label">电流-扭矩关系：</span>
                <span class="equation-value">y = @FitResult.CurrentCoeffs[1].ToString("F8")x + @FitResult.CurrentCoeffs[0].ToString("F8")</span>
            </div>
            <div class="equation">
                <span class="equation-label">转速-扭矩关系：</span>
                <span class="equation-value">y = @FitResult.SpeedCoeffs[1].ToString("F8")x + @FitResult.SpeedCoeffs[0].ToString("F8")</span>
            </div>
            <div class="equation">
                <span class="equation-label">空载转速(n₀)：</span>
                <span class="equation-value">@FitResult.NoLoadSpeed.ToString("F6") rpm</span>
            </div>
            <div class="equation">
                <span class="equation-label">空载电流(I₀)：</span>
                <span class="equation-value">@((OutputCurrentUnit == CurrentUnit.A ? FitResult.NoLoadCurrent : FitResult.NoLoadCurrent * 1000).ToString("F6")) @(OutputCurrentUnit.ToString())</span>
            </div>
            <div class="equation">
                <span class="equation-label">堵转扭矩(Tₖ)：</span>
                <span class="equation-value">@((OutputTorqueUnit switch
                    {
                        TorqueUnit.Nm => FitResult.StallTorque,
                        TorqueUnit.mNm => FitResult.StallTorque * 1000,
                        TorqueUnit.Kgcm => FitResult.StallTorque / 0.0980665,
                        TorqueUnit.gcm => FitResult.StallTorque / 0.0000980665,
                        _ => FitResult.StallTorque
                    }).ToString("F6")) @(OutputTorqueUnit.ToString() == "Kgcm" ? "kg.cm" : OutputTorqueUnit.ToString())</span>
            </div>
            <div class="equation">
                <span class="equation-label">堵转电流(Iₖ)：</span>
                <span class="equation-value">@((OutputCurrentUnit == CurrentUnit.A ? FitResult.StallCurrent : FitResult.StallCurrent * 1000).ToString("F6")) @(OutputCurrentUnit.ToString())</span>
            </div>
            
            <h4>拟合质量分析</h4>
            <div class="fit-quality">
                <div class="quality-row">
                    <div class="quality-group">
                        <h5>电流-扭矩拟合</h5>
                        <div class="result-item">
                            <span class="result-label">决定系数(R²)：</span>
                            <span class="result-value">@FitResult.CurrentR2.ToString("F8")</span>
                        </div>
                        <div class="result-item">
                            <span class="result-label">均方误差(MSE)：</span>
                            <span class="result-value">@FitResult.CurrentMSE.ToString("F8")</span>
                        </div>
                        <div class="result-item">
                            <span class="result-label">均方根误差(RMSE)：</span>
                            <span class="result-value">@FitResult.CurrentRMSE.ToString("F8")</span>
                        </div>
                        <div class="result-item">
                            <span class="result-label">平均绝对误差(MAE)：</span>
                            <span class="result-value">@FitResult.CurrentMAE.ToString("F8")</span>
                        </div>
                    </div>
                    
                    <div class="quality-group">
                        <h5>转速-扭矩拟合</h5>
                        <div class="result-item">
                            <span class="result-label">决定系数(R²)：</span>
                            <span class="result-value">@FitResult.SpeedR2.ToString("F8")</span>
                        </div>
                        <div class="result-item">
                            <span class="result-label">均方误差(MSE)：</span>
                            <span class="result-value">@FitResult.SpeedMSE.ToString("F8")</span>
                        </div>
                        <div class="result-item">
                            <span class="result-label">均方根误差(RMSE)：</span>
                            <span class="result-value">@FitResult.SpeedRMSE.ToString("F8")</span>
                        </div>
                        <div class="result-item">
                            <span class="result-label">平均绝对误差(MAE)：</span>
                            <span class="result-value">@FitResult.SpeedMAE.ToString("F8")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    
    <!-- 特性点结果 -->
    @if (ShowResults)
    {
        <div class="results-container">
            <h3>特性点结果</h3>
            <h4>空载点</h4>
            <div class="efficiency-result">
                <div class="result-item">
                    <span class="result-label">扭矩：</span>
                    <span class="result-value">@((decimal)(OutputTorqueUnit switch
                        {
                            TorqueUnit.Nm => (double)Motor.NoLoadPoint.Torque,
                            TorqueUnit.mNm => (double)Motor.NoLoadPoint.Torque * 1000,
                            TorqueUnit.Kgcm => (double)Motor.NoLoadPoint.Torque / 0.0980665,
                            TorqueUnit.gcm => (double)Motor.NoLoadPoint.Torque / 0.0000980665,
                            _ => (double)Motor.NoLoadPoint.Torque
                        })).ToString("F8") @(OutputTorqueUnit.ToString() == "Kgcm" ? "kg.cm" : OutputTorqueUnit.ToString())</span>
                </div>
                <div class="result-item">
                    <span class="result-label">转速：</span>
                    <span class="result-value">@Motor.NoLoadPoint.Speed.ToString("F8") rpm</span>
                </div>
                <div class="result-item">
                    <span class="result-label">电流：</span>
                    <span class="result-value">@((OutputCurrentUnit == CurrentUnit.A ? (double)Motor.NoLoadPoint.Current : (double)Motor.NoLoadPoint.Current * 1000).ToString("F8")) @(OutputCurrentUnit.ToString())</span>
                </div>
            </div>
            
            <h4>堵转点</h4>
            <div class="efficiency-result">
                <div class="result-item">
                    <span class="result-label">扭矩：</span>
                    <span class="result-value">@((decimal)(OutputTorqueUnit switch
                        {
                            TorqueUnit.Nm => (double)Motor.StallPoint.Torque,
                            TorqueUnit.mNm => (double)Motor.StallPoint.Torque * 1000,
                            TorqueUnit.Kgcm => (double)Motor.StallPoint.Torque / 0.0980665,
                            TorqueUnit.gcm => (double)Motor.StallPoint.Torque / 0.0000980665,
                            _ => (double)Motor.StallPoint.Torque
                        })).ToString("F8") @(OutputTorqueUnit.ToString() == "Kgcm" ? "kg.cm" : OutputTorqueUnit.ToString())</span>
                </div>
                <div class="result-item">
                    <span class="result-label">转速：</span>
                    <span class="result-value">@Motor.StallPoint.Speed.ToString("F8") rpm</span>
                </div>
                <div class="result-item">
                    <span class="result-label">电流：</span>
                    <span class="result-value">@((OutputCurrentUnit == CurrentUnit.A ? (double)Motor.StallPoint.Current : (double)Motor.StallPoint.Current * 1000).ToString("F8")) @(OutputCurrentUnit.ToString())</span>
                </div>
            </div>
        </div>
    }
    
    <!-- 效率计算结果 -->
    @if (ShowEfficiencyResults)
    {
        <div class="results-container">
            <h3>效率计算结果</h3>
            <div class="equation">
                <span class="equation-label">效率变化方程：</span>
                <span class="equation-value">η' = @EfficiencyDerivativeEquation</span>
            </div>
            <h4>最大效率点</h4>
            <div class="efficiency-result">
                <div class="result-item">
                    <span class="result-label">最大效率：</span>
                    <span class="result-value">@MaxEfficiencyValue.ToString("F8")</span>
                </div>
                <div class="result-item">
                    <span class="result-label">对应扭矩：</span>
                    <span class="result-value">@((decimal)(OutputTorqueUnit switch
                        {
                            TorqueUnit.Nm => (double)MaxEfficiencyPoint.Torque,
                            TorqueUnit.mNm => (double)MaxEfficiencyPoint.Torque * 1000,
                            TorqueUnit.Kgcm => (double)MaxEfficiencyPoint.Torque / 0.0980665,
                            TorqueUnit.gcm => (double)MaxEfficiencyPoint.Torque / 0.0000980665,
                            _ => (double)MaxEfficiencyPoint.Torque
                        })).ToString("F8") @(OutputTorqueUnit.ToString() == "Kgcm" ? "kg.cm" : OutputTorqueUnit.ToString())</span>
                </div>
                <div class="result-item">
                    <span class="result-label">对应转速：</span>
                    <span class="result-value">@MaxEfficiencyPoint.Speed.ToString("F8") rpm</span>
                </div>
                <div class="result-item">
                    <span class="result-label">对应电流：</span>
                    <span class="result-value">@((OutputCurrentUnit == CurrentUnit.A ? (double)MaxEfficiencyPoint.Current : (double)MaxEfficiencyPoint.Current * 1000).ToString("F8")) @(OutputCurrentUnit.ToString())</span>
                </div>
            </div>
        </div>
        
        <!-- 性能曲线数据表格 -->
        <div class="results-container">
            <h3>性能曲线数据</h3>
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>扭矩 (@(OutputTorqueUnit.ToString() == "Kgcm" ? "kg.cm" : OutputTorqueUnit.ToString()))</th>
                            <th>转速 (rpm)</th>
                            <th>电流 (@(OutputCurrentUnit.ToString()))</th>
                            <th>效率</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var point in PerformanceCurveData)
                        {
                            <tr>
                                <td>@Math.Round((OutputTorqueUnit switch
                                    {
                                        TorqueUnit.Nm => point.Torque,
                                        TorqueUnit.mNm => point.Torque * 1000,
                                        TorqueUnit.Kgcm => point.Torque / 0.0980665,
                                        TorqueUnit.gcm => point.Torque / 0.0000980665,
                                        _ => point.Torque
                                    }), 2).ToString("F2")</td>
                                <td>@point.Speed.ToString("F0")</td>
                                <td>@Math.Round((OutputCurrentUnit == CurrentUnit.A ? point.Current : point.Current * 1000), 2).ToString("F2")</td>
                                <td>@point.Efficiency.ToString("F4")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    
</div>