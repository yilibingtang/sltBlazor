@page "/ThreadData"
@rendermode InteractiveServer
<PageTitle>螺纹数据查询</PageTitle>

<div class="container">
    <h2>螺纹数据查询</h2>
    
    <!-- 搜索区域 -->
    <div class="search-container">
        <div class="search-group">
            <label for="sizeSearch">尺寸 (Size)</label>
            <input type="text" id="sizeSearch" @bind="searchSize" placeholder="例如: 1, 1.1, 1.2..." />
        </div>
        <div class="search-group">
            <label for="threadSearch">螺纹规格 (Thread)</label>
            <input type="text" id="threadSearch" @bind="searchThread" placeholder="例如: M1x0.25, M2x0.4..." />
        </div>
    </div>
    
    <!-- 数据表格 -->
    <div class="table-container">
        <table class="data-table">
            <thead class="header-row">
                <tr>
                    <th>Size</th>
                    <th>Thread Designation</th>
                    <th colspan="3">External外螺纹</th>
                    <th colspan="3">Internal内螺纹</th>
                </tr>
                <tr>
                    <th></th>
                    <th></th>
                    <th>Class</th>
                    <th>Major Dia大徑 Max</th>
                    <th>Major Dia大徑 Min</th>
                    <th>Class</th>
                    <th>Minor Dia Min</th>
                    <th>Minor Dia Max</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in filteredThreadData)
                {
                    <tr>
                        <td>@item.Size</td>
                        <td>@item.ThreadDesignation</td>
                        <td>@item.ExternalClass</td>
                        <td>@item.ExternalMajorDiaMax</td>
                        <td>@item.ExternalMajorDiaMin</td>
                        <td>@item.InternalClass</td>
                        <td>@item.InternalMinorDiaMin</td>
                        <td>@item.InternalMinorDiaMax</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
