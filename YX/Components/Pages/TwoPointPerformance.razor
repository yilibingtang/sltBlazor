@page "/TwoPointPerformance"
@rendermode InteractiveServer
@using YX.Services
@using YX.Models
<PageTitle>两点计算性能</PageTitle>

<div class="container">
    <h2>两点计算性能</h2>
    
    <!-- 基本信息输入 -->
    <div class="input-row">
        <div class="input-group">
            <label for="motorName">电机名称</label>
            <input type="text" id="motorName" @bind="Motor.MotorName" placeholder="请输入电机名称" />
        </div>
        
        <div class="input-group">
            <label for="voltage">电压 (V)</label>
            <input type="number" id="voltage" @bind="Motor.Voltage" placeholder="请输入电压" step="0.1" min="0" />
        </div>
    </div>
    
    <!-- 单位选择 -->
    <div class="unit-selection">
        <h3>单位设置</h3>
        <div class="input-row">
            <div class="input-group">
                <label>输入扭矩单位：</label>
                <select @bind="InputTorqueUnit">
                    <option value="@TorqueUnit.Nm">Nm</option>
                    <option value="@TorqueUnit.mNm">mNm</option>
                    <option value="@TorqueUnit.Kgcm">kg.cm</option>
                    <option value="@TorqueUnit.gcm">g.cm</option>
                </select>
            </div>
            <div class="input-group">
                <label>输入电流单位：</label>
                <select @bind="InputCurrentUnit">
                    <option value="@CurrentUnit.A">A</option>
                    <option value="@CurrentUnit.mA">mA</option>
                </select>
            </div>
        </div>
        <div class="input-row">
            <div class="input-group">
                <label>输出扭矩单位：</label>
                <select @bind="OutputTorqueUnit">
                    <option value="@TorqueUnit.Nm">Nm</option>
                    <option value="@TorqueUnit.mNm">mNm</option>
                    <option value="@TorqueUnit.Kgcm">kg.cm</option>
                    <option value="@TorqueUnit.gcm">g.cm</option>
                </select>
            </div>
            <div class="input-group">
                <label>输出电流单位：</label>
                <select @bind="OutputCurrentUnit">
                    <option value="@CurrentUnit.A">A</option>
                    <option value="@CurrentUnit.mA">mA</option>
                </select>
            </div>
        </div>
    </div>
    
    <!-- 输入数据表格 -->
    <div class="table-container">
        <h3>输入数据</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th>转速 (rpm)</th>
                    <th>扭矩 (@(InputTorqueUnit.ToString() == "Kgcm" ? "kg.cm" : InputTorqueUnit.ToString()))</th>
                    <th>电流 (@(InputCurrentUnit.ToString()))</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><input type="number" step="0.01" @bind="InputSpeed1" /></td>
                    <td><input type="number" step="0.01" @bind="InputTorque1" /></td>
                    <td><input type="number" step="0.01" @bind="InputCurrent1" /></td>
                </tr>
                <tr>
                    <td><input type="number" step="0.01" @bind="InputSpeed2" /></td>
                    <td><input type="number" step="0.01" @bind="InputTorque2" /></td>
                    <td><input type="number" step="0.01" @bind="InputCurrent2" /></td>
                </tr>
            </tbody>
        </table>
    </div>
    
    <!-- 计算按钮 -->
    <div class="button-group">
        <button class="btn btn-primary" @onclick="CalculateFits">开始计算</button>
    </div>
    
    <!-- 计算结果 -->
    @if (ShowResults)
    {
        <div class="results-container">
            <h3>计算结果</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>转速 (rpm)</th>
                        <th>扭矩 (@(OutputTorqueUnit.ToString() == "Kgcm" ? "kg.cm" : OutputTorqueUnit.ToString()))</th>
                        <th>电流 (@(OutputCurrentUnit.ToString()))</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@OutputSpeed1.ToString("F0")</td>
                        <td>@OutputTorque1.ToString("F2")</td>
                        <td>@OutputCurrent1.ToString("F2")</td>
                    </tr>
                    <tr>
                        <td>@OutputSpeed2.ToString("F0")</td>
                        <td>@OutputTorque2.ToString("F2")</td>
                        <td>@OutputCurrent2.ToString("F2")</td>
                    </tr>
                    <tr>
                        <td>@OutputSpeed3.ToString("F0")</td>
                        <td>@OutputTorque3.ToString("F2")</td>
                        <td>@OutputCurrent3.ToString("F2")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
    
</div>
